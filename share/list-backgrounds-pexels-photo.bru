docs {
Foto stok Pexels: provider=pexels&media=photo.
}

meta {
  name: List Share Backgrounds - Pexels photo
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&page=1&provider=pexels&media=photo
  body: none
  auth: none
}

tests {
  test("200 pexels photo", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal('pexels');
    expect(res.body.data.media).to.equal('photo');
  });
}
