docs {
Foto stok Pixabay: provider=pixabay&media=photo.
}

meta {
  name: List Share Backgrounds - Pixabay photo
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&page=1&provider=pixabay&media=photo
  body: none
  auth: none
}

tests {
  test("200 pixabay photo", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal('pixabay');
    expect(res.body.data.media).to.equal('photo');
  });
}
