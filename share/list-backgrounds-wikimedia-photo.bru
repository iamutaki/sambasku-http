docs {
Foto stok Wikimedia: provider=wikimedia&media=photo.
}

meta {
  name: List Share Backgrounds - Wikimedia photo
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&page=1&provider=wikimedia&media=photo
  body: none
  auth: none
}

tests {
  test("200 wikimedia photo", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal('wikimedia');
    expect(res.body.data.media).to.equal('photo');
  });
}
