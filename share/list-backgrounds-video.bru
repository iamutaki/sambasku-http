docs {
Video stok Pixabay: media=video&provider=pixabay.
}

meta {
  name: List Share Backgrounds - Pixabay video
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&page=1&provider=pixabay&media=video
  body: none
  auth: none
}

tests {
  test("200 video items or degraded", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.provider).to.equal('pixabay');
    expect(res.body.data.media).to.equal('video');
    expect(res.body.data.items).to.be.an('array');
    if (res.body.data.items.length > 0) {
      const item = res.body.data.items[0];
      expect(item.kind).to.equal('video');
      expect(item.mime_type).to.equal('video/mp4');
      expect(item.preview_url).to.be.a('string');
    }
  });
}
