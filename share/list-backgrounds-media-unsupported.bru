docs {
Unsplash tidak mendukung video → 400 field media.
}

meta {
  name: List Share Backgrounds - unsplash video 400
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/share/backgrounds?q=makan%20makanan&provider=unsplash&media=video
  body: none
  auth: none
}

tests {
  test("400 media unsupported", () => {
    expect(res.status).to.equal(400);
    expect(res.body.success).to.equal(false);
    expect(res.body.error_code).to.equal('VALIDATION_ERROR');
  });
}
