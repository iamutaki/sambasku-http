docs {
Lookup miss - lemma tidak ada di KBBI. Harus 200 + found:false
(bukan 404), supaya UI sama pola "kosong" seperti search.
}

meta {
  name: Lookup Lemma Definition Not Found
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/lemma-definitions/lookup?lemma=xyzabcnotexist999
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + found false + suggestions kosong", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.found).to.equal(false);
    expect(res.body.data.entries).to.deep.equal([]);
    expect(res.body.data.suggestions).to.deep.equal([]);
  });
}
