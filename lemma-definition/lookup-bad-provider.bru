docs {
Lookup dengan provider tidak dikenal → 400 VALIDATION_ERROR
(details.field = provider).
}

meta {
  name: Lookup Lemma Definition Bad Provider
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/lemma-definitions/lookup?lemma=makan&provider=unknownvendor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("400 provider tidak dikenal", () => {
    expect(res.status).to.equal(400);
    expect(res.body.error_code).to.equal('VALIDATION_ERROR');
  });
}
