docs {
Tandai semua notifikasi milik user sebagai dibaca.

200: { "success": true, "data": { "updated": 2 } }
}

meta {
  name: Mark All Notifications Read
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/notifications/read-all
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 mark all read", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.updated).to.be.a("number");
  });
}
