docs {
Profil publik by username (19-api-profil-publik.md). Tanpa auth.
Rate limit 100 req/menit per IP. Identitas = username (exact match
setelah decode). Email/phone/hash/is_active tidak pernah tampil.

200 sukses:

    {
      "success": true,
      "data": {
        "username": "budi",
        "role": "reviewer",
        "is_verifier": true,
        "joined_at": "2026-08-01T00:00:00.000Z",
        "stats": {
          "contributions_approved": 12,
          "verifications_done": 34
        }
      }
    }

404 username tidak ada / soft-deleted / nonaktif:

    {
      "success": false,
      "error_code": "USER_NOT_FOUND",
      "message": "User tidak ditemukan",
      "details": null
    }

User sistem anonim boleh dibuka. Tidak ada list/cari user.
}

meta {
  name: Get Public Profile
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/users/{{username}}
  body: none
  auth: none
}

tests {
  test("200 + profil publik tanpa PII", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.username).to.be.a("string");
    expect(res.body.data.role).to.be.a("string");
    expect(res.body.data.is_verifier).to.be.a("boolean");
    expect(res.body.data.joined_at).to.be.a("string");
    expect(res.body.data.stats.contributions_approved).to.be.a("number");
    expect(res.body.data.stats.verifications_done).to.be.a("number");
    expect(res.body.data).to.not.have.property("email");
    expect(res.body.data).to.not.have.property("phone");
    expect(res.body.data).to.not.have.property("is_active");
  });
}
