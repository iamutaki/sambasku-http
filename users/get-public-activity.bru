docs {
Aktivitas publik terbaru by username (tanpa auth). Rate 100/menit per IP.
Satu respons, max 20 item, tanpa kursor. Digabung dari:
kontribusi approved/corrected, komentar published, verifikasi selesai.

200 sukses:

    {
      "success": true,
      "data": {
        "items": [
          {
            "kind": "contribution",
            "occurred_at": "2026-09-20T10:00:00.000Z",
            "word_id": "01JD…",
            "lemma": "makatn",
            "summary": "Kata: makatn"
          }
        ]
      }
    }

404 USER_NOT_FOUND sama seperti profil publik.
Tidak mengekspos bookmark, vote, usulan pending, email, phone, user id.
}

meta {
  name: Get Public Activity
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/users/{{username}}/activity
  body: none
  auth: none
}

tests {
  test("200 + items aktivitas publik", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.items).to.be.an('array');
    expect(res.body.data.items.length).to.be.at.most(20);
    if (res.body.data.items.length > 0) {
      const item = res.body.data.items[0];
      expect(['contribution', 'comment', 'verification']).to.include(item.kind);
      expect(item.occurred_at).to.be.a('string');
      expect(item.summary).to.be.a('string');
      expect(item).to.not.have.property('user_id');
      expect(item).to.not.have.property('email');
    }
  });
}
