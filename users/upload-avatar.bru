docs {
Upload / ganti avatar user login. Multipart field `file`.
Semua role yang sudah login. Rate 20/menit.
Path repo: assets/avatars/<userId>/<ulid>.<ext>.
Ganti foto = unggah baru lalu hapus file lama (best-effort).

200 sukses:

    {
      "success": true,
      "data": {
        "avatar_url": "https://cdn.jsdelivr.net/gh/iamutaki/sambasku-images@main/assets/avatars/…/….jpg"
      }
    }

503 PUBLIC_IMAGE_UPLOAD_UNAVAILABLE jika storage belum dikonfigurasi.
}

meta {
  name: Upload Avatar
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/users/me/avatar
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:multipart-form {
  file: @file(/tmp/sambasku-avatar-sample.jpg)
}

tests {
  test("200 avatar_url ATAU 503 belum dikonfigurasi", () => {
    expect([200, 503]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.data.avatar_url).to.be.a('string');
    } else {
      expect(res.body.error_code).to.equal('PUBLIC_IMAGE_UPLOAD_UNAVAILABLE');
    }
  });
}
