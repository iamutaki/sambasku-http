meta {
  name: Create Word Invalid
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/words
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "language_id": "{{sambas_language_id}}",
    "lemma": "   ",
    "meanings": [],
    "category_ids": [],
    "synonym_word_ids": []
  }
}

tests {
  test("400 VALIDATION_ERROR + details per field", () => {
    expect(res.status).to.equal(400);
    expect(res.body.error_code).to.equal('VALIDATION_ERROR');
    const fields = res.body.details.map((d) => d.field);
    expect(fields).to.include('lemma');
    expect(fields).to.include('meanings');
  });
}
