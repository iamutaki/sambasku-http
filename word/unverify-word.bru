docs {
Cabut verifikasi kata (is_verified false) - verifikator (admin/root/reviewer).
Kebalikan dari Verify Word; audit action "unverify".

200 sukses:

    { "success": true, "data": null }
}

meta {
  name: Unverify Word
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/admin/words/{{word_id}}/unverify
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + data null (verifikasi dicabut)", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.equal(null);
  });
}
