meta {
  name: List Word Classes
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/word-classes
  body: none
  auth: none
}

script:post-response {
  // Simpan id kelas kata pertama (Nomina) untuk create-word.bru
  const nomina = res.body.data.find((wc) => wc.code === 'n');
  bru.setVar('word_class_id', nomina ? nomina.id : '');
}

tests {
  test("status 200 + kelas kata Nomina tersedia", () => {
    expect(res.status).to.equal(200);
    const codes = res.body.data.map((wc) => wc.code);
    expect(codes).to.include('n');
  });
}
