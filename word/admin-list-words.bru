docs {
List kata panel admin - filter published (tabs Tayang / Tidak / Semua).
Auth admin|editor|contributor|root|reviewer.

200: bentuk sama word list publik + status semua boleh.
}

meta {
  name: Admin List Words
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/words?limit=20&published=false
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + array data", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta).to.have.property('has_more');
  });
}
