docs {
Kontribusi contoh kalimat (sample) pada MAKANA kata existing — meaning_id
dari Get Word Detail (variable koleksi). Contributor → pending_review.

201 sukses (contributor):

    {
      "success": true,
      "data": {
        "id": "01JDExample00000000000000",
        "meaning_id": "01JDMeaning0000000000000",
        "source_language_id": "01JD9...",
        "source_sentence": "Iyo makatn dulu kah?",
        "target_language_id": null,
        "target_sentence": null,
        "source_type": null,
        "notes": null,
        "status": "pending_review",
        "is_verified": false,
        "is_corrected": false
      }
    }

404 makna tidak ditemukan → error_code MEANING_NOT_FOUND.
Bahasa sumber tidak dikenal → 400 VALIDATION_ERROR field source_language_id.
}

meta {
  name: Add Example (Contributor)
  seq: 12
}

post {
  url: {{baseUrl}}/api/v1/meanings/{{meaning_id}}/examples
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

body:json {
  {
    "source_language_id": "{{sambas_language_id}}",
    "source_sentence": "Iyo makatn dulu kah?",
    "target_language_id": "{{indonesia_language_id}}",
    "target_sentence": "Sudah makan dulu, ya?",
    "source_type": "native_speaker"
  }
}

tests {
  test("201 + pending_review (approval gate)", () => {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal('pending_review');
    expect(res.body.data.is_verified).to.equal(false);
    expect(res.body.data.id).to.have.lengthOf(26);
  });
}
