docs {
Kontribusi pelafalan (pronounce) pada kata existing (Section 22 approval
gate). By role: contributor → pending_review (masuk antrean, tidak tayang
di detail publik); admin/editor/root/reviewer → published + verified.

201 sukses (contributor):

    {
      "success": true,
      "data": {
        "id": "01JDPronunciation0000000000",
        "word_id": "01JDW6XK2Q...",
        "dialect_id": null,
        "notation": "ipa",
        "value": "/makatn dai/",
        "audio_url": null,
        "speaker_name": "Pak Daud",
        "notes": null,
        "status": "pending_review",
        "is_verified": false,
        "is_corrected": false
      }
    }

404 kata tidak ditemukan → error_code WORD_NOT_FOUND.
Duplikat (kata+dialek+notasi+nilai sama) → 400 VALIDATION_ERROR field value.
}

meta {
  name: Add Pronunciation (Contributor)
  seq: 10
}

post {
  url: {{baseUrl}}/api/v1/words/{{word_id}}/pronunciations
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

script:pre-request {
  // nilai unik per run — hindari tabrakan unique (word, dialek, notasi, nilai)
  bru.setVar('pron_value', '/makatn-' + Date.now() + '/');
}

body:json {
  {
    "notation": "ipa",
    "value": "{{pron_value}}",
    "speaker_name": "Pak Daud"
  }
}

tests {
  test("201 + pending_review (approval gate)", () => {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal('pending_review');
    expect(res.body.data.is_verified).to.equal(false);
    expect(res.body.data.is_corrected).to.equal(false);
    expect(res.body.data.id).to.have.lengthOf(26);
    expect(res.body.data.value).to.equal(bru.getVar('pron_value'));
  });
}
