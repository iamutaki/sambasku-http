docs {
Submit kata sebagai CONTRIBUTOR - approval gate (Section 22):
hasil LANGSUNG pending_review + is_verified false, TIDAK tayang sampai
disetujui verifikator lewat antrean (folder contribution/).
Bandingkan dengan Create Word (admin): published + is_verified true.

201 sukses (contributor):

    {
      "success": true,
      "data": {
        "word_id": "01JDKALINTIAK0000000000",
        "lemma": "kalintiak",
        "word_type": "word",
        "status": "pending_review",
        "is_verified": false,
        "created_at": "2026-09-16T10:00:00.000Z"
      }
    }

GET /words/:id untuk kata ini → 404 (belum tayang).
}

meta {
  name: Create Word (Contributor - pending review)
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/admin/words
  body: json
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

body:json {
  {
    "language_id": "{{sambas_language_id}}",
    "lemma": "kalintiak",
    "meanings": [
      {
        "word_class_id": "{{word_class_id}}",
        "definition": "Ikan sungai kecil",
        "order_index": 1,
        "translations": [
          {
            "language_id": "{{indonesia_language_id}}",
            "translation_text": "ikan kecil",
            "translation_type": "direct"
          }
        ]
      }
    ],
    "word_type": "word",
    "category_ids": [],
    "related_words": [],
    "status": "published"
  }
}

vars:post-response {
  pending_word_id: res.body.data.word_id
}

tests {
  test("201 + pending_review + is_verified false (approval gate)", () => {
    expect(res.status).to.equal(201);
    expect(res.body.data.status).to.equal('pending_review');
    expect(res.body.data.is_verified).to.equal(false);
    expect(res.body.data.word_id).to.have.lengthOf(26);
  });
}
