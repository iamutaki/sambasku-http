docs {
Pencarian Sambas ke Indonesia (default). Pagination cursor-based.

200 sukses:

    {
      "success": true,
      "data": [
        { "id": "01JD...", "lemma": "makatn", "language_id": "01JD...", "language_code": "SBS", "word_type": "word", "status": "published" }
      ],
      "meta": { "limit": 20, "next_cursor": null, "has_more": false }
    }
}

meta {
  name: Search Words
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/words/search
  body: none
  auth: none
}

query {
  q: mak
  limit: 20
}

tests {
  test("status 200 + envelope list + meta cursor-based (Section 13)", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an('array');
    expect(res.body.meta).to.have.property('limit', 20);
    expect(res.body.meta).to.have.property('has_more');
    expect(res.body.meta).to.have.property('next_cursor');
    const nc = res.body.meta.next_cursor;
    expect(nc === null || (typeof nc === 'string' && nc.length === 26)).to.equal(true);
  });

  test("items berisi lemma + language_code (sesuai response schema)", () => {
    if (res.body.data.length > 0) {
      const first = res.body.data[0];
      expect(first).to.have.property('id');
      expect(first).to.have.property('lemma');
      expect(first).to.have.property('language_code');
    }
  });
}
