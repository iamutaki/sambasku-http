docs {
Pulihkan teks asli yang disensor blocklist (09-api-comment.md #6).
}

meta {
  name: Uncensor Comment
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/comments/{{comment_id}}/uncensor
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + body restored", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.is_censored).to.equal(false);
    expect(res.body.data.body_original).to.equal(null);
  });
}
