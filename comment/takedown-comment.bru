docs {
Takedown komentar published (09-api-comment.md). Hanya verifikator.
Status → taken_down; list publik body = null.

200 sukses:

    {
      "success": true,
      "data": {
        "id": "01J...",
        "status": "taken_down",
        "reviewed_by": "01J...",
        "reviewed_at": "2026-09-18T11:00:00.000Z"
      }
    }

409 COMMENT_ALREADY_MODERATED jika sudah di-takedown / bukan published.
}

meta {
  name: Takedown Comment
  seq: 5
}

post {
  url: {{baseUrl}}/api/v1/admin/comments/{{comment_id}}/takedown
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + taken_down", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("taken_down");
    expect(res.body.data.reviewed_by).to.be.a("string").and.not.empty;
  });
}
