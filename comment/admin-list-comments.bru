docs {
List komentar admin (09-api-comment.md). Filter status:
published | taken_down | deleted_by_author.
}

meta {
  name: Admin List Comments
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/comments?status=published
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + list dengan status valid", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const cm of res.body.data) {
      expect(["published", "taken_down", "deleted_by_author"]).to.include(cm.status);
    }
  });
}
