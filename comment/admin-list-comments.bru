docs {
Antrean moderasi komentar (09-api-comment.md) - HANYA verifikator:
admin/root/reviewer (pola antrean kontribusi 03). Filter status (default
pending_review), cursor pagination.

200 sukses:

    {
      "success": true,
      "data": [
        {
          "id": "01J...",
          "word_id": "01J...",
          "user_id": "01J...",
          "username": "kontributor",
          "body": "Kata ini juga sering saya dengar di Sambas",
          "status": "pending_review",
          "reviewed_by": null,
          "reviewed_at": null,
          "created_at": "2026-09-18T10:00:00.000Z"
        }
      ],
      "meta": { "limit": 20, "next_cursor": null, "has_more": false }
    }

401 tanpa token; 403 contributor/editor.
}

meta {
  name: Admin List Comments
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/comments?status=pending_review
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 + antrean dengan info moderasi", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    for (const cm of res.body.data) {
      expect(["pending_review", "published", "rejected"]).to.include(cm.status);
    }
  });
}
