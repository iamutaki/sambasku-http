docs {
Antrean pengajuan verifikator (20-api-verifier-application.md).
Hanya admin/root. Filter status + cursor.
}

meta {
  name: List Verifier Applications (Admin)
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/admin/verifier-applications?status=pending&limit=20
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

script:post-response {
  const items = res.body.data || [];
  if (items[0]) bru.setVar("verifier_application_id", items[0].id);
}

tests {
  test("200 + envelope + meta cursor", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("has_more");
  });
}
