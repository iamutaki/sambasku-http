docs {
Tolak pengajuan (20-api-verifier-application.md). comment wajib.
Role pemohon tidak berubah. User PATCH untuk memperbaiki.
}

meta {
  name: Reject Verifier Application
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/admin/verifier-applications/{{verifier_application_id}}/reject
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "comment": "Nomor HP tidak bisa dihubungi. Perbaiki alamat dan tautan sosial."
  }
}

tests {
  test("200 + rejected", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("rejected");
  });
}
