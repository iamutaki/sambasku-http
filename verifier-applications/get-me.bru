docs {
Pengajuan milik user login (20-api-verifier-application.md).
404 VERIFIER_APPLICATION_NOT_FOUND jika belum apply.
}

meta {
  name: Get My Verifier Application
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/verifier-applications/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 + data milik sendiri", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.be.a("string");
    expect(res.body.data.address).to.be.a("string");
    expect(res.body.data.social_links).to.be.an("array");
  });
}
