docs {
Feed bantuan terjemahan yang sudah tayang (32-api-translation-helps.md).
Tanpa auth. Cursor pagination. Gambar publik hanya public_url (jsDelivr);
URL ImageKit staging tidak pernah muncul di wire publik.

200 sukses:

    {
      "success": true,
      "data": [
        {
          "id": "01JD...",
          "user_id": "01JD...",
          "username": "budi",
          "body": "Apa artinya ini?",
          "images": [{ "public_url": "https://cdn.jsdelivr.net/..." }],
          "status": "published",
          "pinned_reply_id": null,
          "created_at": "2026-09-24T00:00:00.000Z"
        }
      ],
      "meta": { "limit": 20, "next_cursor": null, "has_more": false }
    }
}

meta {
  name: List Published Translation Helps
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/translation-helps?limit=20
  body: none
  auth: none
}

script:post-response {
  const items = res.body.data || [];
  if (items[0]) bru.setVar("translation_help_id", items[0].id);
}

tests {
  test("200 + envelope cursor + published only", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta).to.have.property("has_more");
    expect(res.body.meta).to.have.property("next_cursor");
    for (const item of res.body.data) {
      expect(item.status).to.equal("published");
      expect(item.images).to.be.an("array");
      for (const img of item.images) {
        expect(img).to.have.property("public_url");
        expect(img).to.not.have.property("url");
        expect(img).to.not.have.property("provider_file_id");
      }
    }
  });
}
