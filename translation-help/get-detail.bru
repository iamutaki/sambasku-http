docs {
Detail bantuan terjemahan published + replies (32-api-translation-helps.md).
Tanpa auth untuk published. Reply menyertakan is_verifier + is_pinned.
Body reply null jika taken_down / deleted_by_author.

Set {{translation_help_id}} dari list-published atau isi manual.
}

meta {
  name: Get Translation Help Detail
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/translation-helps/{{translation_help_id}}
  body: none
  auth: none
}

tests {
  test("200 + replies shape", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data.status).to.equal("published");
    expect(res.body.data.replies).to.be.an("array");
    for (const r of res.body.data.replies) {
      expect(r).to.have.property("is_verifier");
      expect(r).to.have.property("is_pinned");
      expect(["published", "taken_down", "deleted_by_author"]).to.include(r.status);
      if (r.status === "published") {
        expect(r.body).to.be.a("string");
      } else {
        expect(r.body).to.equal(null);
      }
    }
  });
}
