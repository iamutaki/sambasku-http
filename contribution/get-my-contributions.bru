docs {
Daftar kontribusi + usulan perubahan milik user login
(21-api-my-contributions.md). Cursor pagination, auth wajib.
}

meta {
  name: Get My Contributions
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/contributions/my?limit=20
  auth: bearer
}

auth:bearer {
  token: {{contributor_access_token}}
}

tests {
  test("200 + list milik pemohon dengan meta cursor", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.be.an("array");
    expect(res.body.meta.has_more).to.be.a("boolean");
  });
}
