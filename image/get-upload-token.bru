meta {
  name: Get Upload Token
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/admin/images/upload-token?folder=/words
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 kredensial upload ATAU 503 kalau provider belum dikonfigurasi", () => {
    expect([200, 503]).to.include(res.status);
    if (res.status === 200) {
      expect(res.body.data.token).to.be.a('string');
      expect(res.body.data.signature).to.be.a('string');
      expect(res.body.data.upload_endpoint).to.contain('imagekit');
    } else {
      expect(res.body.error_code).to.equal('IMAGE_UPLOAD_UNAVAILABLE');
    }
  });
}
