meta {
  name: Forgot Password
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/auth/forgot-password
  body: json
  auth: none
}

body:json {
  {
    "email": "{{admin_email}}"
  }
}

tests {
  test("status 200 + response selalu sama (anti-enumeration)", () => {
    expect(res.status).to.equal(200);
    expect(res.body.data.message).to.equal('Jika email terdaftar, kode reset telah dikirim');
  });
}
