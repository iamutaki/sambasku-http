docs {
POST /api/v1/auth/google/link - hubungkan Google ke akun yang login.
Body: id_token dari SDK Google.
}

meta {
  name: Link Google
  seq: 11
}

post {
  url: {{baseUrl}}/api/v1/auth/google/link
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "id_token": "{{google_id_token}}"
  }
}

tests {
  test("200 / 409", () => {
    expect(res.status).to.be.oneOf([200, 401, 409, 503]);
  });
}
