meta {
  name: Change Password
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/auth/change-password
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "old_password": "Password123",
    "new_password": "PasswordBaru123",
    "confirm_password": "PasswordBaru123"
  }
}

tests {
  test("status 200 - semua session ter-revoke, login ulang dengan password baru", () => {
    expect(res.status).to.be.oneOf([200, 400, 401, 429]);
  });
}
