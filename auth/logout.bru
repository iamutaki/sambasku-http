meta {
  name: Logout
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/auth/logout
  body: none
  auth: none
}

headers {
  Cookie: refresh_token={{refresh_token}}
}

tests {
  test("status 200 + data null", () => {
    expect(res.status).to.equal(200);
    expect(res.body.success).to.equal(true);
    expect(res.body.data).to.equal(null);
  });
}
