meta {
  name: Reset Password
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{reset_token}}",
    "new_password": "Password123"
  }
}

tests {
  test("status 200 (atau 401 kalau token placeholder/expired)", () => {
    expect([200, 401]).to.include(res.status);
  });
}
