docs {
DELETE /api/v1/auth/google/link — lepas tautan Google.
409 LAST_AUTH_METHOD jika OAuth-only tanpa password.
}

meta {
  name: Unlink Google
  seq: 12
}

delete {
  url: {{baseUrl}}/api/v1/auth/google/link
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

tests {
  test("200 / 404 / 409", () => {
    expect(res.status).to.be.oneOf([200, 401, 404, 409]);
  });
}
