meta {
  name: Register
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/register
  body: json
  auth: none
}

body:json {
  {
    "username": "brunotester",
    "email": "bruno@test.com",
    "password": "Password123",
    "confirm_password": "Password123"
  }
}

tests {
  test("201 sukses (atau 409 saat re-run - user sudah terdaftar)", () => {
    if (res.status === 201) {
      expect(res.body.success).to.equal(true);
      expect(res.body.data.user_id).to.be.a('string');
    } else {
      expect(res.status).to.equal(409);
      expect(['EMAIL_ALREADY_EXISTS', 'USERNAME_ALREADY_EXISTS']).to.include(res.body.error_code);
    }
  });
}
